# Copy this file to .env and fill in only the keys you need. .env is ignored by git: never
# commit it, and never paste keys into the group chat or shared documents.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Local models (Ollama) need no key. Set this only if Ollama is not at the default address.
# OLLAMA_HOST=http://localhost:11434
